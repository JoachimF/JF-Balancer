#ifndef _CALIBRATION_H_
#define _CALIBRATION_H_

#include <stdio.h>
#include <complex.h>
#include "filtres.h"
#include "uart_console.h"

#define CAL_RPM          4000    // vitesse unique de calibration et d'équilibrage
#define CAL_NB_MOYENNES  5        // acquisitions moyennées par run
#define MASSE_ESSAI_A_G  0.05      // masse d'essai plan A (g)
#define ANGLE_ESSAI_A    0.0      // angle par rapport au repère laser (deg)
#define MASSE_ESSAI_B_G  0.05
#define ANGLE_ESSAI_B    0.0

#define DIAM_A_MM        66.0     // diamètre où tu poses les masses, plan A
#define DIAM_B_MM        40.0     // idem plan B
#define RAYON_A_MM       (DIAM_A_MM / 2.0)
#define RAYON_B_MM       (DIAM_B_MM / 2.0)

typedef struct
{
    double balourd;       // g.mm
    double angle;         // angle du balourd réel
    double masse;         // masse corrective en grammes
    double angle_cor;     // angle où ajouter cette masse
} balourd_t;

typedef struct
{
    double re;
    double im;
} complex_t;

typedef struct
{
    double amp;
    double phase;
} lockin_t;

typedef struct
{
    double masse;
    double angle;
    double balourd;
} correction_t;

typedef struct
{
    complex_t HAA;
    complex_t HAB;
    complex_t HBA;
    complex_t HBB;
    complex_t det;
    double conditionnement;
} calibration_t;

int calcul_balourd(const calibration_t *cal,lockin_t V1,lockin_t V2,uint16_t rayon_correction_A,uint16_t rayon_correction_B,balourd_t *balA,balourd_t *balB) ;
int calibrer_balancier(lockin_t V1_0a, lockin_t V2_0a,lockin_t V1_0b, lockin_t V2_0b,lockin_t V1_A, lockin_t V2_A,lockin_t V1_B, lockin_t V2_B,
    double masse_test_A,uint16_t rayon_test_A,double masse_test_B,uint16_t rayon_test_B,calibration_t *cal);
void init_calibration(_param_t *param) ;

typedef double complex cplx ;

void cal_run0(void);
void cal_runA(void);
void cal_runB(void);
void cal_calcul(_param_t *param) ;
void cal_verif(void);

static double masse_pour_diametre(cplx U, double diam_mm) ;

#endif